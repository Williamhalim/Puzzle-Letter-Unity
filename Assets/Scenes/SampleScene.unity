PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 372886220}
    m_Modifications:
    - target: {fileID: 35763361159679567, guid: b00b0949f30293e48a75830882847420, type: 3}
      propertyPath: m_Name
      value: Frame 7
      objectReference: {fileID: 0}
    - target: {fileID: 35763361159679567, guid: b00b0949f30293e48a75830882847420, type: 3}
      propertyPath: m_IsActive
