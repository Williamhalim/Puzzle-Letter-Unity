    - target: {fileID: 373761468449569898, guid: b00b0949f30293e48a75830882847420, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 960208908960288017, guid: b00b0949f30293e48a75830882847420, type: 3}
      propertyPath: m_text
      value: "My dearest boy,\n\nThe doctor says more of me will soon slip away.
        Before it does, I need to leave you this.\nIn the attic is a box tied with
        an old ribbon. I always said it was \u201Cjust papers,\u201D but they are
        not only mine. They belonged to someone you\u2019ve asked me about before.
        Perhaps you guessed, from the way I sometimes fell silent at a song, or looked
        at the door as if expecting someone to walk through.\nWhen you are ready,
        open it. Inside is not every answer, but enough to explain why I have loved
        you twice over \u2014 once as your mother, and once as someone who remembers
        what was lost. Even if I forget your name, you are my joy, my atonement,
        my hope. Love does not fade, even if memory does.\n\nAlways,\L Mom"
      objectReference: {fileID: 0}
    - target: {fileID: 960208908960288017, guid: b00b0949f30293e48a75830882847420, type: 3}
      propertyPath: m_fontSize
