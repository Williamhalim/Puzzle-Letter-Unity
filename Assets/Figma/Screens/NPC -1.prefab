--- !u!1 &8982772599559015213
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 8577829874353629475}
  - component: {fileID: 8739253973719594888}
  - component: {fileID: 3461922951717031787}
  - component: {fileID: 8024372263286850801}
  m_Layer: 0
  m_Name: "Dear John,\L It\u2019s so nice to hear from you! Your letter really made
    me smile. I\u2019ve been doing well\u2014work has been busy on my end too, but
    I\u2019ve been enjoying it. My family is doing great, and we recently had a small
    gathering that was a lot of fun. I\u2019ve actually picked up a new hobby lately:
    gardening. It\u2019s been surprisingly relaxing, and I love seeing the plants
    grow little by little. No big adventures yet, but I\u2019ve been taking some
    weekend trips nearby whenever I get the chance.\L I also miss our chats and that
    trip we took together\u2014it really was such a good time. A phone call sounds
    perfect; let\u2019s plan one soon. Hopefully, we can arrange a visit in the near
    future as well.\L Take care of yourself, and thank you again for writing. It
    was really wonderful to hear from you.\L Warmly,\L Emma"
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
