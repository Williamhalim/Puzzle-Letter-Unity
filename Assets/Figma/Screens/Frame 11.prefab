  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Mom,\L\nI read your letter and went to the attic. I saw the box, the ribbon
    fraying. I didn\u2019t open it \u2014 not yet. Some truths feel heavier unopened.\nBut
    I think I know who you meant. I saw it in the pauses, the silences, the way you
    carried both presence and absence at once. Whatever is in that box, it does not
    change you. You were everything to me, mother and more.\nWhen the time is right,
    I\u2019ll untie it. Not to judge, but to carry what you couldn\u2019t "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a4a59b93957e3e7439b920fc11cc2b1e, type: 2}
