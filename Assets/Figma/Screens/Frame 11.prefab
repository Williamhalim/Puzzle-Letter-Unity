--- !u!1 &8008939102002368131
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 6385617382857684471}
  - component: {fileID: 2600307923592451600}
  - component: {fileID: 477462455910703936}
  - component: {fileID: 4658928572816386910}
  m_Layer: 0
  m_Name: "Mom,\L I read your letter and went to the attic. I saw the box, the ribbon
    fraying. I didn\u2019t open it \u2014 not yet. Some truths feel heavier unopened.
    But I think I know who you meant. I saw it in the pauses, the silences, the way
    you carried both presence and absence at once. Whatever is in that box, it does
    not change you. You were everything to me, mother and more. When the time is
    right, I\u2019ll untie it. Not to judge, but to carry what you couldn\u2019t"
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
