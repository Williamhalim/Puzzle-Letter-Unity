--- !u!1 &4889772132291810068
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 9023941527189793628}
  - component: {fileID: 1036507344619182107}
  - component: {fileID: 4896470510390269273}
  - component: {fileID: 5281790290841628091}
  m_Layer: 0
  m_Name: "My dearest boy, The doctor says more of me will soon slip away. Before
    it does, I need to leave you this. In the attic is a box tied with an old ribbon.
    I always said it was \u201Cjust papers,\u201D but they are not only mine. They
    belonged to someone you\u2019ve asked me about before. Perhaps you guessed, from
    the way I sometimes fell silent at a song, or looked at the door as if expecting
    someone to walk through. When you are ready, open it. Inside is not every answer,
    but enough to explain why I have loved you twice over \u2014 once as your mother,"
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
